# Backend-only Supabase credentials. Never use SUPABASE_SECRET_KEY in browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY

# API server
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Frontend API base URL (configured in web/.env.local for local development;
# set to the public API service URL plus /api in the Railway web service).
NEXT_PUBLIC_API_URL=http://localhost:4000/api
